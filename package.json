{
  "name": "individualsavingsflowui",
  "version": "0.11.91",
  "description": "돈의 흐름과 미래 자산 변화를 살펴보는 개인 재무 계획 도우미",
  "main": "sw.js",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/bump-version.js && npm run sync-version && vite build",
    "preview": "vite preview",
    "sync-version": "node scripts/sync-version.js",
    "version": "npm run sync-version && git add public/manifest.webmanifest shared/legacy/sw.js shared/core/utils.js",
    "check": "npm run check:source && npm run check:unit",
    "check:source": "tsc --noEmit",
    "check:unit": "tsc --noEmit -p tsconfig.unit.json",
    "lint": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jinhoOps/IndividualSavingsFlowUI.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/jinhoOps/IndividualSavingsFlowUI/issues"
  },
  "homepage": "https://github.com/jinhoOps/IndividualSavingsFlowUI#readme",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.0.0-alpha.13",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.14.9",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/ui": "^4.1.5",
    "autoprefixer": "^10.4.19",
    "jsdom": "26.1.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^4.0.0-alpha.13",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  }
}
